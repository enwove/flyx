# Files as C++ byte arrays and a table of them, for pages the executable serves (the dashboard):
#   cmake -DLIST=<file> -DOUT=<file.cpp> -DNAMESPACE=<ns> -DNAME=<symbol> -P cmake/embed_files.cmake
# LIST holds one "served/path=source/path" a line.  Defines in NAMESPACE
#   `const EmbeddedFile NAME[]` ({path, data, size}) and `const size_t NAME##Count`.
# Byte arrays, not string literals: MSVC caps those at 16 KB.
file(STRINGS "${LIST}" entries)
set(arrays "")
set(table "")
set(count 0)
foreach(entry IN LISTS entries)
  string(FIND "${entry}" "=" eq)
  string(SUBSTRING "${entry}" 0 ${eq} served)
  math(EXPR from "${eq} + 1")
  string(SUBSTRING "${entry}" ${from} -1 source)
  file(READ "${source}" hex HEX)
  string(LENGTH "${hex}" digits)
  math(EXPR size "${digits} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n" bytes "${bytes}")
  string(APPEND arrays "const unsigned char f${count}[] = {\n${bytes}0x00};\n")
  string(APPEND table "    {\"${served}\", f${count}, ${size}},\n")
  math(EXPR count "${count} + 1")
endforeach()
file(WRITE "${OUT}.tmp"
     "// Generated by cmake/embed_files.cmake from ${LIST}: do not edit.\n"
     "#include <cstddef>\n"
     "namespace ${NAMESPACE} {\n"
     "struct EmbeddedFile { const char* path; const unsigned char* data; size_t size; };\n"
     "namespace {\n${arrays}}  // namespace\n"
     "extern const EmbeddedFile ${NAME}[] = {\n${table}};\n"
     "extern const size_t ${NAME}Count = ${count};\n"
     "}  // namespace ${NAMESPACE}\n")
# Rewritten only when the bytes changed: the object depending on it is not rebuilt for nothing.
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
