{
  "version": 5,
  "configurePresets": [
    {
      "name": "base-ninja",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "base-windows",
      "hidden": true,
      "inherits": "base-ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "FLYX_COMPILER_CACHE": "OFF"
      }
    },
    {
      "name": "base-release-pkg",
      "hidden": true,
      "inherits": "base-ninja",
      "cacheVariables": {
        "FLYX_STATIC_RUNTIME": "ON",
        "FLYX_CUDA_ARCHS": "80-real;89-real;90-real;100-real;120-real;120-virtual",
        "FLYX_CUDA_LINEINFO": "OFF",
        "FLYX_CUDA_COMPRESS": "size",
        "FLYX_TUNE_CANDIDATES": "OFF"
      }
    },
    {
      "name": "dev",
      "inherits": "base-ninja",
      "displayName": "Development (Release, tests, this machine's GPU architectures)",
      "binaryDir": "$env{HOME}/flyx-build",
      "cacheVariables": { "FLYX_TESTS": "ON", "FLYX_TEST_DV": "OFF" }
    },
    {
      "name": "debug",
      "inherits": "dev",
      "displayName": "Debug (RelWithDebInfo: line info)",
      "binaryDir": "$env{HOME}/flyx-build-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "cpu",
      "inherits": "dev",
      "displayName": "CPU only (float64 reference backend)",
      "binaryDir": "$env{HOME}/flyx-build-cpu",
      "cacheVariables": { "FLYX_CUDA": "OFF" }
    },
    {
      "name": "dev-windows",
      "inherits": "base-windows",
      "displayName": "Development on Windows (Release, tests, MSVC, this machine's GPU)",
      "binaryDir": "$env{USERPROFILE}/flyx-build",
      "cacheVariables": { "FLYX_TESTS": "ON", "FLYX_TEST_DV": "OFF" }
    },
    {
      "name": "cpu-windows",
      "inherits": "dev-windows",
      "displayName": "CPU only on Windows (float64 reference backend)",
      "binaryDir": "$env{USERPROFILE}/flyx-build-cpu",
      "cacheVariables": { "FLYX_CUDA": "OFF" }
    },
    {
      "name": "dev-full",
      "inherits": "dev",
      "displayName": "dev's build tree with DV's tests registered too (test preset full)",
      "cacheVariables": { "FLYX_TEST_DV": "ON" }
    },
    {
      "name": "cpu-full",
      "inherits": "cpu",
      "displayName": "cpu's build tree with DV's tests registered too (test preset cpu-full)",
      "cacheVariables": { "FLYX_TEST_DV": "ON" }
    },
    {
      "name": "dev-windows-full",
      "inherits": "dev-windows",
      "displayName": "dev-windows's build tree with DV's tests registered too (test preset full-windows)",
      "cacheVariables": { "FLYX_TEST_DV": "ON" }
    },
    {
      "name": "cpu-windows-full",
      "inherits": "cpu-windows",
      "displayName": "cpu-windows's build tree with DV's tests registered too (test preset cpu-full-windows)",
      "cacheVariables": { "FLYX_TEST_DV": "ON" }
    },
    {
      "name": "release-linux",
      "inherits": "base-release-pkg",
      "displayName": "Release package: Linux / WSL2 x86_64, CUDA 13, driver only at run time",
      "binaryDir": "$env{HOME}/flyx-build-release",
      "cacheVariables": {
        "FLYX_TESTS": "ON",
        "CMAKE_INSTALL_PREFIX": "$env{HOME}/flyx-build-release/stage"
      }
    },
    {
      "name": "release-windows",
      "inherits": ["base-windows", "base-release-pkg"],
      "displayName": "Release package: Windows x86_64, MSVC 2022, CUDA 13, driver only at run time",
      "binaryDir": "$env{USERPROFILE}/flyx-build-release",
      "cacheVariables": {
        "FLYX_CUDA_ARCHS": "80-real;89-real;120-real",
        "FLYX_TESTS": "OFF",
        "CMAKE_INSTALL_PREFIX": "$env{USERPROFILE}/flyx-build-release/stage"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "cpu", "configurePreset": "cpu" },
    { "name": "dev-windows", "configurePreset": "dev-windows" },
    { "name": "cpu-windows", "configurePreset": "cpu-windows" },
    { "name": "release-linux", "configurePreset": "release-linux" },
    { "name": "release-windows", "configurePreset": "release-windows" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "description": "The engine's and server's settings (core/os/env.h) cleared: an empty value is no setting, so the tests run on what they give the engine (a test's own ENVIRONMENT still sets its own), never on the shell's FLYX_BACKEND_DIR, FLYX_BACKEND_OPTIONS or FLYX_API_KEY; PYTHONOPTIMIZE cleared, which would take the asserts out of the Python tests.",
      "environment": {
        "FLYX_BACKEND": "",
        "FLYX_BACKEND_DIR": "",
        "FLYX_DRAFTER": "",
        "FLYX_ACTIVATIONS": "",
        "FLYX_BACKEND_OPTIONS": "",
        "FLYX_CHAT_NATIVE": "",
        "FLYX_LOOKUP": "",
        "FLYX_DRAFT_TREES": "",
        "FLYX_ADAPTIVE": "",
        "FLYX_LEARN_COSTS": "",
        "FLYX_API_KEY": "",
        "FLYX_KEY": "",
        "FLYX_MODELS_DIR": "",
        "PYTHONOPTIMIZE": ""
      },
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 8, "resourceSpecFile": "${sourceDir}/tests/gpu_resources.json" }
    },
    { "name": "quick-base", "hidden": true, "inherits": "test-base", "filter": { "include": { "label": "^quick$" } } },
    { "name": "no-dv-base", "hidden": true, "inherits": "test-base", "filter": { "exclude": { "label": "^dv$" } } },
    {
      "name": "full-base",
      "hidden": true,
      "inherits": "test-base",
      "environment": { "FLYX_TEST_REQUIRE_DV": "1" }
    },
    { "name": "dev", "inherits": "no-dv-base", "configurePreset": "dev" },
    { "name": "cpu", "inherits": "no-dv-base", "configurePreset": "cpu" },
    { "name": "dev-windows", "inherits": "no-dv-base", "configurePreset": "dev-windows" },
    { "name": "cpu-windows", "inherits": "no-dv-base", "configurePreset": "cpu-windows" },
    { "name": "quick", "inherits": "quick-base", "configurePreset": "dev" },
    { "name": "gpu", "inherits": "no-dv-base", "configurePreset": "dev" },
    { "name": "full", "inherits": "full-base", "configurePreset": "dev-full" },
    { "name": "cpu-quick", "inherits": "quick-base", "configurePreset": "cpu" },
    { "name": "cpu-full", "inherits": "full-base", "configurePreset": "cpu-full" },
    { "name": "quick-windows", "inherits": "quick-base", "configurePreset": "dev-windows" },
    { "name": "gpu-windows", "inherits": "no-dv-base", "configurePreset": "dev-windows" },
    { "name": "full-windows", "inherits": "full-base", "configurePreset": "dev-windows-full" },
    { "name": "cpu-quick-windows", "inherits": "quick-base", "configurePreset": "cpu-windows" },
    { "name": "cpu-full-windows", "inherits": "full-base", "configurePreset": "cpu-windows-full" },
    { "name": "release-linux", "inherits": "no-dv-base", "configurePreset": "release-linux" }
  ]
}
