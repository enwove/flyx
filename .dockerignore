# What the image build never reads: a smaller context means a faster `docker build` and no secrets in it.
# tests/, bench/ and docs/ are excluded because the image is built with -DFLYX_TESTS=OFF (packaging/Dockerfile.server);
# a build that wants them out of the context must take those lines out.

# build trees, packages, logs
build/
build-*/
dist/
assets/
logs/
flyx-build*/
.sync.tar.gz

# git and CI
.git
.gitattributes
.github

# Python caches and local environments
__pycache__/
*.pyc
.venv/
.venv-*/

# local configuration and secrets
.env
.env.*
!.env.example
CMakeUserPresets.json

# model files: mount them at /models (FLYX_MODELS_DIR), the image never carries one
*.gguf
*.safetensors
*.bin
*.flyx

# not built into the image
docs/
tests/
bench/
